<?php

/**
 * @file
 * D11 Multilingual module.
 *
 * Provides language-scoped translator access control and multilingual
 * theme helpers (RTL direction, hreflang links).
 */

use Drupal\Core\Language\LanguageInterface;
use Drupal\Core\Access\AccessResult;
use Drupal\Core\Entity\ContentEntityInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\node\NodeInterface;

/**
 * Implements hook_node_access().
 *
 * Restricts translators to languages assigned on their user account
 * via the field_translator_languages field.
 */
function d11_multilingual_node_access(NodeInterface $node, $op, AccountInterface $account) {
  if ($op !== 'update' || !$account->hasRole('translator')) {
    return AccessResult::neutral();
  }

  $user_storage = \Drupal::entityTypeManager()->getStorage('user');
  $user = $user_storage->load($account->id());

  if (!$user || !$user->hasField('field_translator_languages')) {
    return AccessResult::neutral()->cachePerUser();
  }

  $allowed = array_column($user->get('field_translator_languages')->getValue(), 'value');

  if (empty($allowed)) {
    return AccessResult::neutral()->cachePerUser();
  }

  $node_lang = $node->language()->getId();

  if (!in_array($node_lang, $allowed, TRUE)) {
    return AccessResult::forbidden('Translator is not assigned to this language.')
      ->cachePerUser()
      ->addCacheableDependency($node);
  }

  return AccessResult::neutral()->cachePerUser();
}

/**
 * Implements hook_preprocess_html().
 *
 * Sets dir="rtl" on the <html> element for RTL languages and attaches
 * the RTL stylesheet for Arabic.
 */
function d11_multilingual_preprocess_html(&$variables) {
  $rtl_languages = ['ar'];
  $current_lang = \Drupal::languageManager()->getCurrentLanguage()->getId();

  if (in_array($current_lang, $rtl_languages, TRUE)) {
    $variables['html_attributes']['dir'] = 'rtl';
    $variables['html_attributes']['lang'] = $current_lang;
  }
}

/**
 * Implements hook_preprocess_page().
 *
 * Injects hreflang alternate link tags for every available translation
 * of the current page entity.
 */
function d11_multilingual_preprocess_page(&$variables) {
  $language_manager = \Drupal::languageManager();
  $route_match = \Drupal::routeMatch();
  $entity = NULL;

  // Attempt to resolve the current route's entity.
  foreach ($route_match->getParameters() as $param) {
    if ($param instanceof ContentEntityInterface) {
      $entity = $param;
      break;
    }
  }

  if (!$entity || !$entity->isTranslatable()) {
    return;
  }

  $languages = $language_manager->getLanguages();
  $hreflang_links = [];

  foreach ($languages as $langcode => $language) {
    if (!$entity->hasTranslation($langcode)) {
      continue;
    }
    $translated = $entity->getTranslation($langcode);
    $url = $translated->toUrl('canonical')->setAbsolute(TRUE)->toString();
    $hreflang_links[] = [
      '#tag' => 'link',
      '#attributes' => [
        'rel' => 'alternate',
        'hreflang' => $langcode,
        'href' => $url,
      ],
    ];
  }

  // x-default points to the English version.
  if ($entity->hasTranslation('en')) {
    $en_url = $entity->getTranslation('en')->toUrl('canonical')->setAbsolute(TRUE)->toString();
    $hreflang_links[] = [
      '#tag' => 'link',
      '#attributes' => [
        'rel' => 'alternate',
        'hreflang' => 'x-default',
        'href' => $en_url,
      ],
    ];
  }

  foreach ($hreflang_links as $delta => $link) {
    $variables['page']['#attached']['html_head'][] = [$link, 'hreflang_' . $delta];
  }
}

/**
 * Implements hook_views_query_alter().
 *
 * Ensures Views queries are filtered to the active content language to
 * prevent cross-language content bleed in cached results.
 */
function d11_multilingual_views_query_alter($view, $query) {
  $content_lang = \Drupal::languageManager()
    ->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)
    ->getId();

  // Only alter views that query translatable node-based tables.
  if (!isset($query->tables['node_field_data'])) {
    return;
  }

  // Add a langcode condition if none already exists.
  $existing_conditions = array_column($query->where[0]['conditions'] ?? [], 'field');
  if (!in_array('node_field_data.langcode', $existing_conditions, TRUE)) {
    $query->addWhere(0, 'node_field_data.langcode', $content_lang);
  }
}
